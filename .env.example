# PostgreSQL connection string
DATABASE_URL=postgres://milandhoo:milandhoo@localhost:5432/milandhoo_market

# Public URL of the site (used in share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Long random string used to hash one-time codes. Generate with: openssl rand -hex 32
AUTH_SECRET=change-me

# Comma-separated phone numbers that become admins when they sign in
ADMIN_PHONES=+9607000000

# Trial mode: shows the sign-in code on screen instead of sending an SMS, with a
# "demo" banner on every page. Anyone can sign in as any number. Never for real orders.
DEMO_LOGIN=false
# Add the demo shops and listings when the database is set up (trial only)
SEED_DEMO=false

# SMS provider for login codes: "console" (development: prints codes to the server log)
# or "twilio". The console provider is refused in production unless DEMO_LOGIN=true.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Image storage: "local" (saves under ./uploads, good for a single server),
# "neon" (Neon Object Storage; uses the AWS_* variables below that Neon provides)
# or "s3" (any S3-compatible bucket: AWS S3, Cloudflare R2, Supabase Storage...)
STORAGE_DRIVER=local

# Neon Object Storage (STORAGE_DRIVER=neon). `neon deploy` / `neon env pull` fill these in.
NEON_BUCKET=uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# Other S3-compatible storage (STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL that serves the bucket's files
S3_PUBLIC_URL=
